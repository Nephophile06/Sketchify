# MongoDB connection URI (e.g. MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ or local: mongodb://localhost:27017/)
MONGO_URI=mongodb://localhost:27017/

# Admin credentials
ADMIN_NAME=admin
ADMIN_PASS=admin123

# Flask App Secret Key
SECRET_KEY=your_secret_key_here

# Flask-Mail Configuration (for sending 8-digit backup code and invoices)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Payment Gateway (Stripe)
stripe_api_key=your_stripe_secret_key

# Payment Gateway (SSLCommerz)
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWD=your_sslcommerz_store_password
SSLCOMMERZ_IS_SANDBOX=true
